# Runtime data comes entirely from MongoDB. Use a dedicated database.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=adigrams
MONGODB_DB=adigrams_dashboard
PORT=5174

# Only needed for db:extract when migrating the original files. Neither is
# needed after db:import or when importing a friend's migration-data.json.
# REPORT_SOURCE=/path/to/ADIGRAMS_GOLIVE_READINESS.html
# ADIGRAM_STORE=/path/to/adigram-store.json

# Access gate. The dashboard ships with the code 00000000; set either of these
# to change it without a rebuild. DASHBOARD_ACCESS_VERIFIER is preferred, since
# it keeps the code itself out of the environment:
#   node -e "import('./server/access.mjs').then(m=>console.log(m.hashCode('12345678')))"
# DASHBOARD_SESSION_SECRET is optional; it defaults to a key derived from the
# verifier, which is stable across instances but rotates with the code.
# DASHBOARD_ACCESS_CODE=12345678
# DASHBOARD_ACCESS_VERIFIER=pbkdf2-sha256$210000$...$...
# DASHBOARD_SESSION_SECRET=
