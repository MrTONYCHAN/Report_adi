# Runtime data comes entirely from MongoDB. Use a dedicated database.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=adigrams
MONGODB_DB=adigrams_dashboard
PORT=5174

# Only needed for db:extract when migrating the original files. Neither is
# needed after db:import or when importing a friend's migration-data.json.
# REPORT_SOURCE=/path/to/ADIGRAMS_GOLIVE_READINESS.html
# ADIGRAM_STORE=/path/to/adigram-store.json
