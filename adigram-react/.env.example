# Absolute path to the original, unencrypted readiness report. Read on each API request.
REPORT_SOURCE=/path/to/ADIGRAMS_GOLIVE_READINESS.html
PORT=5174

# Where the dashboard keeps its own register: tasks and defects added here,
# status moves made on report records, and the workflow audit log. The readiness
# report itself is never written to. Defaults to server/adigram-store.json.
# ADIGRAM_STORE=/path/to/adigram-store.json
